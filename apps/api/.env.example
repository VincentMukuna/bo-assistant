# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
MASTRA_URL=http://localhost:4111
MASTRA_INTERNAL_TOKEN=replace-with-a-shared-internal-token
# Development accepts local, LAN, and Tailscale origins automatically.
# In production, set this to the exact customer application origin.
CUSTOMER_APP_ORIGIN=http://localhost:3100

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
