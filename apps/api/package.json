{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  },
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "bun run bin/server.js",
    "build": "bun --conditions=development run ace.js build",
    "dev": "HOST=0.0.0.0 bun --conditions=development run ace.js serve --hmr",
    "test": "NODE_ENV=test bun --conditions=development --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "key:generate": "bun --conditions=development run ace.js generate:key",
    "db:migrate": "bun --conditions=development run ace.js migration:run",
    "db:seed": "bun --conditions=development run ace.js db:seed",
    "db:fresh": "bun --conditions=development run ace.js migration:fresh && bun --conditions=development run ace.js db:seed"
  },
  "imports": {
    "#controllers/*": {
      "development": "./app/controllers/*.ts",
      "default": "./app/controllers/*.js"
    },
    "#contracts/*": {
      "development": "./app/contracts/*.ts",
      "default": "./app/contracts/*.js"
    },
    "#actions/*": {
      "development": "./app/actions/*.ts",
      "default": "./app/actions/*.js"
    },
    "#exceptions/*": {
      "development": "./app/exceptions/*.ts",
      "default": "./app/exceptions/*.js"
    },
    "#models/*": {
      "development": "./app/models/*.ts",
      "default": "./app/models/*.js"
    },
    "#mails/*": {
      "development": "./app/mails/*.ts",
      "default": "./app/mails/*.js"
    },
    "#services/*": {
      "development": "./app/services/*.ts",
      "default": "./app/services/*.js"
    },
    "#listeners/*": {
      "development": "./app/listeners/*.ts",
      "default": "./app/listeners/*.js"
    },
    "#events/*": {
      "development": "./app/events/*.ts",
      "default": "./app/events/*.js"
    },
    "#generated/*": {
      "development": "./.adonisjs/server/*.ts",
      "default": "./.adonisjs/server/*.js"
    },
    "#middleware/*": {
      "development": "./app/middleware/*.ts",
      "default": "./app/middleware/*.js"
    },
    "#transformers/*": {
      "development": "./app/transformers/*.ts",
      "default": "./app/transformers/*.js"
    },
    "#validators/*": {
      "development": "./app/validators/*.ts",
      "default": "./app/validators/*.js"
    },
    "#providers/*": {
      "development": "./providers/*.ts",
      "default": "./providers/*.js"
    },
    "#policies/*": {
      "development": "./app/policies/*.ts",
      "default": "./app/policies/*.js"
    },
    "#abilities/*": {
      "development": "./app/abilities/*.ts",
      "default": "./app/abilities/*.js"
    },
    "#database/*": {
      "development": "./database/*.ts",
      "default": "./database/*.js"
    },
    "#tests/*": {
      "development": "./tests/*.ts",
      "default": "./tests/*.js"
    },
    "#start/*": {
      "development": "./start/*.ts",
      "default": "./start/*.js"
    },
    "#config/*": {
      "development": "./config/*.ts",
      "default": "./config/*.js"
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.4",
    "@types/node": "~26.2.0",
    "eslint": "^10.8.1",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.4.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@japa/api-client": "^3.2.1",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "better-result": "^3.0.1",
    "better-sqlite3": "workspace:*",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.1.12"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  }
}
