{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development mastra dev --dir .",
    "build": "mastra build --dir . && bun run scripts/finalize-build.ts",
    "start": "mastra start",
    "test": "bun test tests/*.test.mjs",
    "evals": "bun run evals/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "1.59.0",
    "@mastra/loggers": "1.2.0",
    "@mastra/memory": "1.26.2",
    "@mastra/pg": "1.20.0",
    "better-result": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@mastra/evals": "1.7.0",
    "@mastra/libsql": "1.20.0",
    "@types/bun": "^1.3.3",
    "mastra": "1.25.0",
    "typescript": "^6.0.3"
  }
}
