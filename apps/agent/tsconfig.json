{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["bun"],
    "noEmit": true
  },
  "include": [
    "index.ts",
    "storage.ts",
    "agents/**/*",
    "tools/**/*",
    "lib/**/*",
    "scorers/**/*",
    "evals/**/*"
  ]
}
