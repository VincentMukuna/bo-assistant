{
  "name": "bo-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run agent:db:start && turbo dev",
    "dev:app": "turbo dev --filter=app",
    "dev:api": "turbo dev --filter=api",
    "dev:agent": "turbo dev --filter=agent",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:api": "turbo test --filter=api",
    "evals": "npm run evals --workspace=agent",
    "agent:start": "docker compose up -d --build agent",
    "agent:db:start": "docker compose up -d --wait mastra-db",
    "agent:db:stop": "docker compose stop mastra-db",
    "agent:logs": "docker compose logs --follow --tail=100 agent",
    "agent:status": "docker compose ps agent",
    "agent:stop": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "db:fresh": "npm run db:fresh --workspace=api"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "^1.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.10"
  }
}
